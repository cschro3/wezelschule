# Configure hosted values through Sites runtime variables, never commit real values.
# Canonical HTTPS origin, without trailing slash. Example: https://school.example
AUTH_BASE_URL=
# migration: keep the existing trusted Sites identity until the verified owner activates local login.
# local: require password login, MFA for administrators and server-side sessions.
# platform: emergency rollback to the trusted Sites identity, only behind the private Sites gate.
AUTH_MODE=migration
# Generate at least 32 random bytes in a password/secret manager. Never use a fixed example value.
BETTER_AUTH_SECRET=
# Verified sender, and credential for the implemented Resend mail adapter.
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# Existing platform owner mapping; preserve the configured account.
OWNER_EMAIL=
